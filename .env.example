# Explicit synthetic demonstration. Change to blizzard and supply credentials for real profiles.
PROVIDER_MODE=fixture
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Empty keeps the default for PROVIDER_MODE. Set warcraftlogs to use the public client API.
COMBAT_PROVIDER_MODE=
# Separate database for live reports. Create it before running migrations.
# For Compose use postgres://kipet:kipet@postgres:5432/kipet_warcraftlogs?sslmode=disable
COMBAT_DATABASE_URL=
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
RAIDERIO_ENABLED=false
APP_HMAC_SECRET=local-development-only-replace-this-before-real-use
DATABASE_URL=postgres://kipet:kipet@127.0.0.1:5432/kipet?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
API_ADDR=127.0.0.1:8080
INTERNAL_ADDR=127.0.0.1:9091
WORKER_INTERNAL_ADDR=127.0.0.1:9092
WORKER_CONCURRENCY=4
API_REPLICAS=1
# Native development needs no trusted proxy. Compose trusts only its nginx container.
TRUSTED_PROXY_CIDRS=
